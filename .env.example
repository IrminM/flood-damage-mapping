# Copy to .env and edit. .env is git-ignored — never commit real credentials.

# Where data and analysis runs live (defaults: ./data and ./data/runs)
FLOODMAP__PATHS__DATA_DIR=./data
FLOODMAP__PATHS__RUNS_DIR=./data/runs

# Optional extra YAML merged over config/default.yaml
# FLOODMAP_CONFIG=config/local.yaml

# Logging
FLOODMAP__LOGGING__LEVEL=INFO

# Selected segmentation model: baseline_unet | teammate_unet | none
# FLOODMAP__AI__MODEL=baseline_unet

# Copernicus Data Space Ecosystem (only needed by scripts/fetch_s1_openeo.py
# if you use client-credentials instead of the interactive browser login).
# CDSE_OPENEO_CLIENT_ID=
# CDSE_OPENEO_CLIENT_SECRET=
